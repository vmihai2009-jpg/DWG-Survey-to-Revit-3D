<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Survey to Revit "engine": the tools themselves. Revit does not load this directly; the launcher
       (SurveyToRevit.Launcher) loads the newest installed copy on each click.
       Revit 2025 add-in. Revit 2025 runs on .NET 8 (Windows).
       The Revit API reference assemblies come from NuGet so the project builds
       without Revit installed; at run time Revit supplies its own copies. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SurveyToRevit.Revit</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Release number: the Updater compares it with the zips it finds, and names the install folder after it -->
    <Version>0.13.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- File picker. Referenced directly (rather than UseWindowsForms) so the add-in also builds on Linux CI. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <!-- Revit's UI API refers to WPF types. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SurveyToRevit.Core\SurveyToRevit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UserSettings.cs" Link="UserSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon96.png" LogicalName="icon96.png" />
  </ItemGroup>

</Project>
