<Project Sdk="Microsoft.NET.Sdk">

  <!-- The part of Survey to Revit that Revit loads at start-up: the ribbon panel, the Updater and Settings.
       It loads the rest (the "engine", SurveyToRevit.Revit and its files) from its own versioned folder on
       each click, so a new release takes effect without restarting Revit. Keep this small and stable:
       changes here only show after a restart. It must not reference the engine projects. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SurveyToRevit.Launcher</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Only raise when this project changes: a newer launcher is installed for the next restart. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UserSettings.cs" Link="UserSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SurveyToRevit.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
